# ——— محیط اجرا ———
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ——— دسترسی مالک (تک‌کاربره) ———
OWNER_PASSWORD=please-change-min-10-chars

# ——— داده‌ها ———
DATABASE_URL=postgres://user:pass@localhost:5432/appins
SESSION_SECRET=please-change-me-to-a-long-random-string-32chars

# ——— اینستاگرام (مرحله ۴ — فقط برای اتصال واقعی) ———
# مقادیر از App Dashboard > Instagram > API setup with Instagram login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:4000/instagram/callback

# ——— تلگرام (اختیاری تا مرحله ربات) ———
TELEGRAM_BOT_TOKEN=

# ——— هوش مصنوعی کپشن (اختیاری) ———
AI_PROVIDER_API_KEY=
