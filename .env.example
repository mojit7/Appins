# ——— محیط اجرا ———
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ——— دسترسی مالک (تک‌کاربره) ———
OWNER_PASSWORD=please-change-min-10-chars

# ——— داده‌ها ———
DATABASE_URL=postgres://user:pass@localhost:5432/appins
SESSION_SECRET=please-change-me-to-a-long-random-string-32chars

# ——— اینستاگرام (مرحله ۴ — فقط برای اتصال واقعی) ———
# مقادیر از App Dashboard > Instagram > API setup with Instagram login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:4000/instagram/callback

# ——— تلگرام (اختیاری تا مرحله ربات) ———
TELEGRAM_BOT_TOKEN=

# ——— هوش مصنوعی کپشن (مرحله ۶ — سازگار با OpenAI Chat Completions) ———
# نمونه OpenRouter:  AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1  AI_PROVIDER_MODEL=openrouter/auto
# نمونه NVIDIA NIM:  AI_PROVIDER_BASE_URL=https://integrate.api.nvidia.com/v1  AI_PROVIDER_MODEL=meta/llama-3.1-8b-instruct
# هر سه متغیر باید هم‌زمان تنظیم شوند؛ در غیاب آن‌ها تولید 503 می‌دهد.
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_MODEL=
AI_TIMEOUT_MS=25000

# ——— زمان‌بند انتشار (مرحله ۸) ———
# نظرسنجی درون‌فرآیندی روی صف ماندگار Postgres؛ سقف تلاش و پایه عقب‌نشینی نمایی
SCHEDULER_INTERVAL_MS=30000
SCHEDULE_MAX_ATTEMPTS=3
SCHEDULE_RETRY_BASE_MS=60000
